# Contact form delivery.
#
# The form posts to a Server Action, which sends the message through Resend.
# Without all three of these the form refuses to claim success: it tells the
# visitor plainly that it isn't connected and points them at the channels
# listed further down the page.
#
# Copy this file to `.env.local` for development. On Vercel, set the same three
# as Environment Variables — none of them is NEXT_PUBLIC_, so they stay on the
# server and never reach the browser bundle.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where messages are delivered. The only place this address exists.
CONTACT_TO_EMAIL=

# The sender. Must be on a domain verified in Resend — a Gmail address here
# will be rejected. Something like: Portfolio <contact@yourdomain.com>
CONTACT_FROM_EMAIL=
